# =====================================================================
# STACKPILOT - Environment Variables
# =====================================================================

# Environment Mode
ENVIRONMENT=development
DEBUG=True

# Application Server
PORT=8000
# Keep this on loopback while the API has no authentication. Do not set 0.0.0.0.
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Host names the API answers to (the Host header). Keep loopback only while there is no authentication:
# it blocks DNS-rebinding attacks. Names only (no port); "*" is refused at startup.
ALLOWED_HOSTS=127.0.0.1,localhost

# Database Configuration (PostgreSQL with pgvector, or SQLite fallback)
# Production / Docker Compose:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/stackpilot
# Local Development Fallback:
DATABASE_URL=sqlite+aiosqlite:///./stackpilot.db

# Workspaces: folder holding one directory per project (empty = <backend>/workspaces)
WORKSPACES_ROOT=
# Largest file (bytes) the file API will read or write
MAX_FILE_SIZE_BYTES=2097152
# Project imports (ZIP upload and GitHub download), enforced on the bytes actually read or written:
# largest ZIP accepted (50 MB), largest total size it may extract to (200 MB), most entries it may contain
MAX_UPLOAD_BYTES=52428800
MAX_ZIP_UNCOMPRESSED_BYTES=209715200
MAX_ZIP_ENTRIES=5000

# LLM Provider Configuration
# Privacy switch. While false (the default), nothing a user types and no project code is ever sent to an AI provider,
# even if LLM_PROVIDER and LLM_API_KEY are set below. Set to true only if you accept sending questions to that provider.
ALLOW_SENDING_CODE_TO_PROVIDER=false

# Safety switch for the "Run the whole project" feature. While false (the default) no project code is ever started.
# Set to true only for projects you trust: it runs the project's own install and start commands on this computer.
ALLOW_RUNNING_PROJECT_CODE=false
# Where per-project virtual environments live (empty = <backend>/runtime)
RUNTIME_ROOT=

LLM_PROVIDER=openai
LLM_API_KEY=your-llm-api-key-here
LLM_MODEL=gpt-4o

# Embedding Provider Configuration
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=your-embedding-api-key-here
EMBEDDING_MODEL=text-embedding-3-small

# Authentication & Security
JWT_SECRET=super-secret-stackpilot-jwt-token-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# GitHub Integration
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Cache & Queue (Redis - optional in MVP)
REDIS_URL=redis://localhost:6379/0

# Docker Sandbox Settings
DOCKER_SANDBOX_ENABLED=False
DOCKER_SANDBOX_TIMEOUT_SECONDS=60
DOCKER_SANDBOX_MEMORY_LIMIT=512m
