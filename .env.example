# =====================================================================
# STACKPILOT - Environment Variables
# =====================================================================

# Environment Mode
ENVIRONMENT=development
DEBUG=True

# Application Server
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Configuration (PostgreSQL with pgvector, or SQLite fallback)
# Production / Docker Compose:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/stackpilot
# Local Development Fallback:
DATABASE_URL=sqlite+aiosqlite:///./stackpilot.db

# Workspaces: folder holding one directory per project (empty = <backend>/workspaces)
WORKSPACES_ROOT=
# Largest file (bytes) the file API will read or write
MAX_FILE_SIZE_BYTES=2097152

# LLM Provider Configuration
LLM_PROVIDER=openai
LLM_API_KEY=your-llm-api-key-here
LLM_MODEL=gpt-4o

# Embedding Provider Configuration
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=your-embedding-api-key-here
EMBEDDING_MODEL=text-embedding-3-small

# Authentication & Security
JWT_SECRET=super-secret-stackpilot-jwt-token-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# GitHub Integration
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Cache & Queue (Redis - optional in MVP)
REDIS_URL=redis://localhost:6379/0

# Docker Sandbox Settings
DOCKER_SANDBOX_ENABLED=False
DOCKER_SANDBOX_TIMEOUT_SECONDS=60
DOCKER_SANDBOX_MEMORY_LIMIT=512m
